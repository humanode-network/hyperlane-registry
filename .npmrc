# Our packages are published under @humanode-hyperlane on npm.
@humanode-hyperlane:registry=https://registry.npmjs.org/

# Nothing here uses upstream's @hyperlane-xyz scope. It points at an address
# that never resolves, so a package left under that name, for example by a
# backport that skipped scripts/humanode-scope.sh, can be neither installed
# nor published.
@hyperlane-xyz:registry=https://npm.invalid/
